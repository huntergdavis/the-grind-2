+++ b/src/narrator/farewell-prompt-memory.ts
@@ -0,0 +1,64 @@
+import type { CreativeStoryMemory } from "./creative-continuity";
+import type { CreativeStoryFocus, CreativeStoryViewpoint } from "./creative-story";
+import type { FarewellRemembrance } from "./farewell-remembrance";
+import type { StoryBeatJobV1 } from "./story-beat";
+
+const unsafeName = /[\p{Cc}\p{Cf}\p{Cs}\p{Zl}\p{Zp}<>`*_{}\[\]]|&(?:[a-z]{2,}|#(?:\d+|x[\da-f]+));/iu;
+
+function safeName(value: unknown): value is string {
+  return typeof value === "string" && value.length > 0 && value.length <= 128
+    && value === value.trim() && !unsafeName.test(value);
+}
+
+function validTick(value: unknown): value is number {
+  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
+}
+
+function mentionsLiteralName(text: string, name: string): boolean {
+  const normalize = (value: string) => value.normalize("NFC").replace(/[\u2018\u2019]/gu, "'");
+  const normalized = normalize(text);
+  const escaped = normalize(name).replace(/[.*+?^${}()|[\]\\]/gu, "\\$&");
+  const pattern = new RegExp(`(?<![\\p{L}\\p{M}\\p{N}_])${escaped}(?![\\p{L}\\p{M}\\p{N}_])`, "gu");
+  for (const match of normalized.matchAll(pattern)) {
+    const start = match.index;
+    const end = start + match[0].length;
+    // Quoted names and possessives count; O'Rowan and Rowan-Lee are other names.
+    if (/[\p{L}\p{M}\p{N}_]['-]$/u.test(normalized.slice(0, start))
+      || /^(?:-[\p{L}\p{M}\p{N}_]|'(?!s(?=$|[^\p{L}\p{M}\p{N}_]))[\p{L}\p{M}\p{N}_])/u.test(normalized.slice(end))) continue;
+    return true;
+  }
+  return false;
+}
+
+/** Narrow prompt context only; callers must keep the full captured selection for duplicate admission. */
+export function selectFarewellPromptMemory(
+  job: StoryBeatJobV1,
+  viewpoint: CreativeStoryViewpoint | null | undefined,
+  focus: CreativeStoryFocus,
+  remembrance: FarewellRemembrance | null | undefined,
+  continuity: readonly CreativeStoryMemory[],
+): readonly CreativeStoryMemory[] {
+  // The producer verifies the actual departure. Reuse the controller's source
+  // binding here, without imposing new headline wording on existing records.
+  if (focus === "scene" || remembrance?.kind !== "farewell-remembrance" || viewpoint?.companion !== null
+    || !safeName(remembrance.companionName) || !safeName(remembrance.heroName)
+    || remembrance.heroName !== viewpoint.hero?.name
+    || !validTick(job.tick) || !validTick(remembrance.tick)
+    || !validTick(remembrance.oath?.tick) || !validTick(remembrance.farewell?.tick)
+    || remembrance.campaignId !== job.campaignId || remembrance.eventId !== job.eventId
+    || remembrance.tick !== job.tick || remembrance.oath.tick >= remembrance.tick
+    || remembrance.farewell.tick !== remembrance.tick
+    || remembrance.farewell.location !== job.facts.location
+    || remembrance.farewell.headline !== job.facts.headline) return continuity;
+
+  let latest: CreativeStoryMemory | undefined;
+  for (const entry of continuity) {
+    if (entry.campaignId !== job.campaignId || entry.sourceEventId === job.eventId
+      || !validTick(entry.sourceTick) || entry.sourceTick >= job.tick
+      || entry.scene?.location !== remembrance.farewell.location || typeof entry.text !== "string"
+      || !mentionsLiteralName(entry.text, remembrance.companionName)) continue;
+    if (latest === undefined || entry.sourceTick > latest.sourceTick
+      || (entry.sourceTick === latest.sourceTick && entry.sourceEventId > latest.sourceEventId)) latest = entry;
+  }
+  return latest === undefined ? continuity : Object.freeze([latest]);
+}
