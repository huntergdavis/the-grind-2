@@ -0,0 +1,121 @@
+import { describe, expect, it } from "vitest";
+import { captureCreativeStoryMemory, type CreativeStoryMemory } from "./creative-continuity";
+import type { CreativeStoryViewpoint } from "./creative-story";
+import type { FarewellRemembrance } from "./farewell-remembrance";
+import type { StoryBeatJobV1 } from "./story-beat";
+import { selectFarewellPromptMemory } from "./farewell-prompt-memory";
+
+function fixture() {
+  const job: StoryBeatJobV1 = {
+    schemaVersion: 1, task: "author-story-beat", disposition: "manual-ephemeral-noncanonical",
+    campaignId: "campaign", eventId: "farewell-12", tick: 12, sourceFingerprint: "0123456789abcdef",
+    facts: { schemaVersion: 1, kind: "public-story-beat", location: "Greyford",
+      headline: "Mara says goodbye to Rowan.", action: "Rowan departs wounded but alive.",
+      consequence: "The party has no active companion." },
+    deterministicFallback: "Rowan leaves.", maximumInputTokens: 320, maximumOutputTokens: 48,
+  };
+  const viewpoint: CreativeStoryViewpoint = { hero: { name: "Mara", values: ["loyalty"] }, companion: null };
+  const remembrance = { kind: "farewell-remembrance", campaignId: job.campaignId, eventId: job.eventId, tick: job.tick,
+    heroName: "Mara", companionName: "Rowan",
+    oath: { location: "Copper Hollow", headline: "Rowan joins the road.", tick: 1 },
+    farewell: { location: job.facts.location, headline: job.facts.headline, tick: job.tick },
+  } satisfies FarewellRemembrance;
+  const road = { campaignId: job.campaignId, sourceEventId: "road-2", sourceTick: 2,
+    text: "Mara worried about Rowan on the unfinished road.",
+    scene: { location: "Old Road", headline: "The road continues." } };
+  const arrival = { campaignId: job.campaignId, sourceEventId: "arrival-8", sourceTick: 8,
+    text: "Mara's relief at arriving did not quiet her concern for Rowan.",
+    scene: { location: job.facts.location, headline: "The oath destination is reached." } };
+  return { job, viewpoint, remembrance, road, arrival };
+}
+
+describe("farewell prompt memory selection", () => {
+  it("prefers the newest already-selected destination passage naming the departing person", () => {
+    const { job, viewpoint, remembrance, road, arrival } = fixture();
+    const newerRoad = { ...road, sourceTick: 10 };
+    const selection = [arrival, newerRoad];
+    expect(selectFarewellPromptMemory(job, viewpoint, "inner-life", remembrance, selection)).toEqual([arrival]);
+    const olderArrival = { ...arrival, sourceEventId: "arrival-6", sourceTick: 6 };
+    expect(selectFarewellPromptMemory(job, viewpoint, "shared-road", remembrance, [arrival, olderArrival])).toEqual([arrival]);
+    expect(selection).toEqual([arrival, newerRoad]);
+  });
+
+  it("uses captured chronology and source identity for deterministic same-tick ties", () => {
+    const { job, viewpoint, remembrance, arrival } = fixture();
+    const laterId = { ...arrival, sourceEventId: "arrival-z" };
+    for (const entries of [[arrival, laterId], [laterId, arrival]]) {
+      expect(selectFarewellPromptMemory(job, viewpoint, "inner-life", remembrance, entries)).toEqual([laterId]);
+    }
+  });
+
+  it("keeps the original selection when legacy metadata, a destination match, or a named passage is absent", () => {
+    const { job, viewpoint, remembrance, road, arrival } = fixture();
+    const { scene: _scene, ...legacy } = arrival;
+    for (const entries of [[], [road], [road, legacy], [road, { ...arrival, text: "Relief came with a quiet worry." }],
+      [road, { ...arrival, campaignId: "another" }], [road, { ...arrival, sourceTick: job.tick }]]) {
+      expect(selectFarewellPromptMemory(job, viewpoint, "inner-life", remembrance, entries)).toBe(entries);
+    }
+  });
+
+  it.each(["campaign", "event", "tick", "hero", "oath", "farewell-tick", "location", "headline", "unsafe-name"] as const)(
+    "keeps context unchanged when the captured farewell has invalid %s binding", (wrong) => {
+      const { job, viewpoint, remembrance, road, arrival } = fixture();
+      if (wrong === "campaign") remembrance.campaignId = "another";
+      if (wrong === "event") remembrance.eventId = "another";
+      if (wrong === "tick") remembrance.tick = NaN;
+      if (wrong === "hero") remembrance.heroName = "Another hero";
+      if (wrong === "oath") remembrance.oath.tick = remembrance.tick;
+      if (wrong === "farewell-tick") remembrance.farewell.tick += 1;
+      if (wrong === "location") remembrance.farewell.location = "Another town";
+      if (wrong === "headline") remembrance.farewell.headline = "Another departure";
+      if (wrong === "unsafe-name") remembrance.companionName = "<Rowan>";
+      const entries = [road, arrival];
+      expect(selectFarewellPromptMemory(job, viewpoint, "inner-life", remembrance, entries)).toBe(entries);
+    },
+  );
+
+  it("leaves Scene, absent remembrance/viewpoints, and an active companion unchanged", () => {
+    const { job, viewpoint, remembrance, road, arrival } = fixture();
+    const entries = [road, arrival];
+    expect(selectFarewellPromptMemory(job, viewpoint, "scene", remembrance, entries)).toBe(entries);
+    for (const absent of [null, undefined]) {
+      expect(selectFarewellPromptMemory(job, absent, "inner-life", remembrance, entries)).toBe(entries);
+      expect(selectFarewellPromptMemory(job, viewpoint, "inner-life", absent, entries)).toBe(entries);
+    }
+    const active: CreativeStoryViewpoint = { ...viewpoint, companion: {
+      name: "Rowan", role: "miller", status: "injured", purpose: "shared-road-oath", victories: 1,
+    } };
+    expect(selectFarewellPromptMemory(job, active, "inner-life", remembrance, entries)).toBe(entries);
+  });
+
+  it.each(["Rowanette", "McRowan", "Rowan2", "Rowan_2", "O'Rowan", "Rowan-Lee", "Rowan’son", "Rowanleigh"])(
+    "does not mistake %s for the departing name", (otherName) => {
+      const { job, viewpoint, remembrance, road, arrival } = fixture();
+      const entries = [road, { ...arrival, text: `Mara felt concern for ${otherName}.` }];
+      expect(selectFarewellPromptMemory(job, viewpoint, "inner-life", remembrance, entries)).toBe(entries);
+    },
+  );
+
+  it("accepts quoted names, possessives, and literal Unicode or regex-sensitive names", () => {
+    const { job, viewpoint, remembrance, road, arrival } = fixture();
+    for (const [name, text] of [["Rowan", "Mara watched Rowan’s face."], ["Rowan", "'Rowan,' Mara whispered."],
+      ["Élodie D’Arcy", "Mara worried about E\u0301lodie D'Arcy."], ["A.+", "Mara worried about A.+."]]) {
+      const matching = { ...arrival, text: text! };
+      expect(selectFarewellPromptMemory(job, viewpoint, "inner-life", { ...remembrance, companionName: name! },
+        [road, matching])).toEqual([matching]);
+    }
+  });
+
+  it("does not lose captured prose when the mutable archive changes later", () => {
+    const { job, viewpoint, remembrance, road, arrival } = fixture();
+    const captured = captureCreativeStoryMemory(job, [road, arrival]);
+    const narrowed = selectFarewellPromptMemory(job, viewpoint, "inner-life", remembrance, captured);
+    expect(narrowed).toEqual([captured[1]]);
+    expect(Object.isFrozen(narrowed)).toBe(true);
+    expect(narrowed[0]).toBe(captured[1]);
+    arrival.text = "Changed after capture.";
+    arrival.scene.location = "Elsewhere";
+    expect(narrowed[0]!.text).toContain("concern for Rowan");
+    expect(captured).toHaveLength(2);
+  });
+});
