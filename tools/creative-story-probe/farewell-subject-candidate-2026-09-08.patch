diff --git a/src/narrator/farewell-story-subject.ts b/src/narrator/farewell-story-subject.ts
new file mode 100644
--- /dev/null
+++ b/src/narrator/farewell-story-subject.ts
@@ -0,0 +1,34 @@
+import type { CreativeStoryViewpoint } from "./creative-story";
+import type { FarewellRemembrance } from "./farewell-remembrance";
+import type { StoryBeatJobV1 } from "./story-beat";
+
+const unsafeName = /[\p{Cc}\p{Cf}\p{Cs}\p{Zl}\p{Zp}<>`*_{}\[\]]|&(?:[a-z]{2,}|#(?:\d+|x[\da-f]+));/iu;
+
+function safeName(value: unknown): value is string {
+  return typeof value === "string" && value.length > 0 && value.length <= 128
+    && value === value.trim() && !unsafeName.test(value);
+}
+
+function validTick(value: unknown): value is number {
+  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
+}
+
+/** A person in this recorded departure, not an active companion or a name inferred from prose. */
+export function captureFarewellStorySubject(
+  job: StoryBeatJobV1,
+  viewpoint: CreativeStoryViewpoint | null | undefined,
+  remembrance?: FarewellRemembrance | null,
+): string | null {
+  if (remembrance?.kind !== "farewell-remembrance" || viewpoint?.companion !== null
+    || !safeName(viewpoint.hero?.name) || !safeName(remembrance.heroName)
+    || !safeName(remembrance.companionName) || remembrance.heroName !== viewpoint.hero.name
+    || !validTick(job.tick) || !validTick(remembrance.tick)
+    || !validTick(remembrance.oath?.tick) || !validTick(remembrance.farewell?.tick)
+    || remembrance.campaignId !== job.campaignId || remembrance.eventId !== job.eventId
+    || remembrance.tick !== job.tick || remembrance.oath.tick >= remembrance.tick
+    || remembrance.farewell.tick !== remembrance.tick
+    || remembrance.farewell.location !== job.facts.location
+    || remembrance.farewell.headline !== job.facts.headline
+    || job.facts.headline !== `${remembrance.companionName}'s Shared Road Oath is complete.`) return null;
+  return remembrance.companionName;
+}
