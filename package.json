{
  "name": "the-grind-2",
  "version": "0.5.64",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run check:version && npm run check:boundaries && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "pixi.js": "8.20.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
